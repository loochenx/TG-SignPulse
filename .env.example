# Telegram API 凭证（可选）
# 如果不设置，将使用内置默认配置；也可以在 WebUI 系统设置中配置
# 如需使用自己的凭证，从 https://my.telegram.org 获取
# TG_API_ID=your_api_id_here
# TG_API_HASH=your_api_hash_here

# 面板登录密钥（可选）
# 留空会在数据目录生成并持久保存随机密钥；少于16字符的值也会改用此密钥。
# 自行设置时使用随机长字符串，例如: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=

# 可选配置
PORT=8080
APP_DATA_DIR=/data

# 面板 2FA TOTP 时间窗口容差（默认 0，仅当前 30s；可设 1 表示允许前后各 1 个窗口）
# APP_TOTP_VALID_WINDOW=1

# 代理设置（NAS / 国内环境访问 Telegram Bot API 时可能需要）
# 格式示例: socks5://host:port 或 socks5://user:pass@host:port 或 http://host:port
# 也可在 WebUI 系统设置中配置，两者均影响 Bot 通知发送
# TG_PROXY=socks5://127.0.0.1:1080

# Telegram Session 模式（默认 file）
# TG_SESSION_MODE=file
# TG_SESSION_NO_UPDATES=0
# TG_GLOBAL_CONCURRENCY=1
